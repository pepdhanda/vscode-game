@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace)
    {
        <span class="diya-mark">🪔</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "relative flex items-center justify-center p-1 text-center rounded-lg transition-all duration-150 select-none min-h-[60px] text-xs leading-tight font-medium";

        string stateClasses;
        if (Square.IsMarked)
        {
            if (IsWinning)
            {
                stateClasses = "bingo-square-winning text-maroon font-bold";
            }
            else
            {
                stateClasses = "bingo-square-marked text-green";
            }
        }
        else
        {
            stateClasses = "bingo-square text-secondary";
        }

        var freeSpaceClasses = Square.IsFreeSpace ? "bingo-square-free font-bold text-sm text-gold" : "";

        return $"{baseClasses} {stateClasses} {freeSpaceClasses}";
    }
}
