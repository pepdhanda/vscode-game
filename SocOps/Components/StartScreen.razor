<div class="flex flex-col items-center justify-center min-h-full p-6 bg-kolam-subtle relative overflow-hidden">
    <!-- Minimal Corner Decorations -->
    <div class="absolute top-4 right-4 text-gold text-2xl opacity-20" style="font-family: serif;" aria-hidden="true">❈</div>
    <div class="absolute bottom-4 left-4 text-gold text-2xl opacity-20" style="font-family: serif;" aria-hidden="true">❈</div>

    <div class="text-center max-w-md relative py-12">
        <!-- Hero Section with Staggered Animation -->
        <div class="animate-fade-up">
            <div class="text-3xl mb-4 animate-pulse-gold">🪔</div>
            <h1 class="font-display text-6xl text-maroon mb-1 tracking-wide">சோக் ஓப்ஸ்</h1>
        </div>
        
        <p class="text-xl font-semibold text-secondary mb-8 tracking-wider animate-fade-up" style="animation-delay: 0.15s;">Soc Ops</p>

        <!-- How to Play - Minimalist Card -->
        <div class="bg-white border-2 border-cream rounded-xl p-6 mb-8 shadow-md animate-fade-up" style="animation-delay: 0.3s;">
            <h2 class="font-semibold text-maroon mb-4 text-base tracking-wider">How to Play</h2>
            <ol class="text-left text-secondary text-sm space-y-3">
                <li class="flex items-start gap-3">
                    <span class="font-bold text-maroon">1.</span>
                    <span>Find people who match the questions</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="font-bold text-maroon">2.</span>
                    <span>Tap a square when you find a match</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="font-bold text-maroon">3.</span>
                    <span>Get 5 in a row to win!</span>
                </li>
            </ol>
        </div>

        <!-- Start Button - Simplified -->
        <button
            @onclick="OnStart"
            class="w-full btn-primary font-semibold py-4 px-8 rounded-xl text-lg tracking-wider animate-fade-up"
            style="animation-delay: 0.45s;"
            aria-label="Start game">
            Start · தொடங்கு
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
